AWS_REGION=ap-northeast-1
BEDROCK_EMBED_MODEL_ID=cohere.embed-v4:0
BEDROCK_EMBED_DIM=1536
BEDROCK_CHAT_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=1024
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
RAG_TOP_K=5

# ベクトルストア切り替え: pgvector (ローカル/CI) | s3vectors (AWS, Phase 2)
VECTOR_STORE=pgvector
S3_VECTORS_BUCKET=
S3_VECTORS_INDEX=chunks

# Phase 2: 取り込み元 PDF の保管先バケット (出典・再現性の証跡)
DOCS_BUCKET=

LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=
